# PlaceTrack Server Environment Variables
PORT=5000
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# Cloud MySQL Connection URL (optional, overrides individual params)
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/placetrack

# Individual MySQL Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=placetrack
DB_SSL=false
# Set DB_SSL=true when using cloud MySQL providers requiring SSL (e.g. Aiven, TiDB Cloud)
