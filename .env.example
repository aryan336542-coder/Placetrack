# ==========================================
# PlaceTrack Environment Configuration
# ==========================================

PORT=5000
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# Option 1: Cloud MySQL Connection URL (Aiven, TiDB Cloud, Railway, etc.)
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/placetrack?ssl={"rejectUnauthorized":true}

# Option 2: Individual MySQL Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=placetrack
DB_SSL=false
# Set DB_SSL=true if connecting to Aiven / TiDB Cloud / managed cloud database with SSL
